{
  "name": "ui-lib",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "migrate-ui-lib": "node scripts/migrate-ui-lib.mjs",
    "build-ui-lib": "npm run migrate-ui-lib && ng build ms-ui && node scripts/snapshot-ui-lib-build.mjs",
    "version-ui-lib": "node scripts/version-ui-lib.mjs",
    "version-ui-lib:patch": "npm run version-ui-lib -- patch && npm run build-ui-lib",
    "version-ui-lib:minor": "npm run version-ui-lib -- minor && npm run build-ui-lib",
    "version-ui-lib:major": "npm run version-ui-lib -- major && npm run build-ui-lib",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/router": "^22.1.2",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@types/prismjs": "^1.26.6",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
